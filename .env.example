# ────────────────────────────────────────────────────────────────────────────
# Podchives env config.
# Copy to .env for local dev. For production, set these in the Vercel
# dashboard (web app) and Render dashboard (worker) — DO NOT commit secrets.
# ────────────────────────────────────────────────────────────────────────────

# ---- Database ----
# Postgres + pgvector. Use Supabase project's "Connection pooling" string.
DATABASE_URL=postgresql://user:password@localhost:5432/podchives

# ---- OpenAI ----
# Used by Whisper transcription + text-embedding-3-small.
OPENAI_API_KEY=

# ---- YouTube (recommended for downloads) ----
# YouTube often returns HTTP 403 without browser cookies. Pick ONE:
#
# Option A — cookies file (best for production / Render worker):
#   1. Install a "Get cookies.txt LOCALLY" browser extension
#   2. Export youtube.com cookies while logged into YouTube
#   3. Save as storage/cookies.txt in this project
YOUTUBE_COOKIES_FILE=storage/cookies.txt
#
# Option B — read cookies directly from your browser (easiest for local dev):
#   YOUTUBE_COOKIES_FROM_BROWSER=chrome
#   (also works: firefox, safari, brave, edge)
YOUTUBE_COOKIES_FROM_BROWSER=

# ---- Object storage (reserved) ----
# Local fs is used when empty. Will be wired to Supabase Storage / S3 later.
STORAGE_BUCKET=

# ---- UI mode ----
# true  → app renders mock data from /lib/demoData.ts (no DB needed)
# false → app talks to DATABASE_URL
NEXT_PUBLIC_DEMO_MODE=true

# ---- Single-user beta gate ----
# When set, the entire app is gated behind this password (one user, one
# password, signed cookie). Leave empty for local dev or pure-demo deploys.
# Pick a long random string for production. Example:
#   openssl rand -base64 32
BETA_PASSWORD=

# ---- Processing / worker ----
PROCESSING_MODE=local
OVERNIGHT_PROCESSING_ENABLED=false
OVERNIGHT_START_TIME=02:00
MAX_JOBS_PER_RUN=3
# How many jobs the worker runs in parallel. Default 1. Higher drains the
# backlog faster (jobs are mostly network-bound); lower if YouTube throttles
# parallel downloads or the machine runs hot.
WORKER_CONCURRENCY=1

# ---- Auto-sync ----
# The worker periodically re-syncs every source to ingest newly-published
# videos and re-queue any backlog episodes that still need processing.
# AUTO_SYNC_ENABLED=false turns it off entirely.
AUTO_SYNC_ENABLED=true
# How stale a source can be (minutes) before it's re-synced. Default 360 (6h).
AUTO_SYNC_INTERVAL_MINUTES=360
